# Vinyl — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# Supabase project URL (find at supabase.com → your project → Settings → API)
VITE_SUPABASE_URL=

# Supabase anon (public) key — safe for client-side use
VITE_SUPABASE_ANON_KEY=

# --- Server-only (NEVER use in client code, NEVER prefix with VITE_) ---
# These are set in Netlify dashboard or Supabase edge function secrets.

# Supabase service role key — used ONLY in edge functions for privileged operations
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for verifying payment webhook signatures
VINYL_WEBHOOK_SECRET=
